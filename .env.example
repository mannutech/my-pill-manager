# Which backend the extractor uses: anthropic | openai | ollama | mock
LLM_PROVIDER=mock

# Only needed for the provider you pick:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama (local, free, no key). Needs `ollama serve` running + a vision model:
#   ollama pull qwen2.5vl:3b
OLLAMA_HOST=http://localhost:11434
# For a cloud deploy reaching a laptop-hosted Ollama, expose it via a
# Cloudflare quick tunnel and set OLLAMA_HOST to the public URL instead:
#   cloudflared tunnel --url http://localhost:11434 --http-host-header localhost:11434
# (the --http-host-header flag matters: Ollama 403s on non-localhost Host headers)
# OLLAMA_HOST=https://<your>.trycloudflare.com
OLLAMA_MODEL=qwen2.5vl:3b
